<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard | adidas</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
    <div class="admin-wrapper">
        <!-- Sidebar -->
        <%- include('layout') %>

        <!-- Main Content -->
        <main class="admin-main">
            <!-- Top Bar -->
            <header class="admin-topbar d-flex align-items-center justify-content-between px-4 py-3 bg-white border-bottom sticky-top">
                <button class="btn btn-link d-lg-none p-0 text-dark sidebar-toggle" onclick="toggleSidebar()">
                    <i class="bi bi-list fs-4"></i>
                </button>
                <div class="d-flex align-items-center gap-2 ms-auto">
                    <span class="badge bg-dark rounded-1 ls-1">ADMIN</span>
                    <span class="text-muted small fw-medium"><%= typeof user !== 'undefined' && user ? user.name : 'Admin' %></span>
                </div>
            </header>

            <!-- Flash Messages -->
            <div class="px-4 mt-3">
                <%- include('../partials/flash') %>
            </div>

            <!-- Page Content -->
            <div class="admin-content p-4">
                <div class="mb-4">
                    <h1 class="h3 fw-bold mb-1">Dashboard</h1>
                    <p class="text-muted small mb-0">Welcome back! Here's an overview of your store.</p>
                </div>

                <!-- Stats Cards -->
                <div class="row g-3 mb-4">
                    <div class="col-sm-6 col-xl-4">
                        <div class="card border-0 shadow-sm h-100 stat-card">
                            <div class="card-body d-flex align-items-center gap-3">
                                <div class="stat-icon bg-dark text-white rounded-3 d-flex align-items-center justify-content-center" style="width:56px;height:56px;">
                                    <i class="bi bi-box-seam fs-4"></i>
                                </div>
                                <div>
                                    <h3 class="h2 fw-bold mb-0"><%= productCount %></h3>
                                    <p class="text-muted small text-uppercase mb-0 ls-05">Total Products</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-xl-4">
                        <div class="card border-0 shadow-sm h-100 stat-card">
                            <div class="card-body d-flex align-items-center gap-3">
                                <div class="stat-icon bg-secondary text-white rounded-3 d-flex align-items-center justify-content-center" style="width:56px;height:56px;">
                                    <i class="bi bi-grid fs-4"></i>
                                </div>
                                <div>
                                    <h3 class="h2 fw-bold mb-0"><%= categoryCount %></h3>
                                    <p class="text-muted small text-uppercase mb-0 ls-05">Categories</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-xl-4">
                        <div class="card border-0 shadow-sm h-100 stat-card">
                            <div class="card-body d-flex align-items-center gap-3">
                                <div class="stat-icon bg-dark bg-opacity-75 text-white rounded-3 d-flex align-items-center justify-content-center" style="width:56px;height:56px;">
                                    <i class="bi bi-people fs-4"></i>
                                </div>
                                <div>
                                    <h3 class="h2 fw-bold mb-0"><%= userCount %></h3>
                                    <p class="text-muted small text-uppercase mb-0 ls-05">Registered Users</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Quick Actions -->
                <div class="mb-4">
                    <h2 class="h5 fw-bold mb-3">Quick Actions</h2>
                    <div class="d-flex gap-2 flex-wrap">
                        <a href="/admin/products/new" class="btn btn-dark d-inline-flex align-items-center gap-2">
                            <i class="bi bi-plus-lg"></i> Add Product
                        </a>
                        <a href="/admin/categories/new" class="btn btn-outline-dark d-inline-flex align-items-center gap-2">
                            <i class="bi bi-plus-lg"></i> Add Category
                        </a>
                    </div>
                </div>

                <!-- Recent Products -->
                <div class="mb-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h2 class="h5 fw-bold mb-0">Recent Products</h2>
                        <a href="/admin/products" class="text-dark text-decoration-none fw-medium small">View All <i class="bi bi-arrow-right"></i></a>
                    </div>
                    <div class="card border-0 shadow-sm">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="text-uppercase small fw-semibold text-muted">Image</th>
                                        <th class="text-uppercase small fw-semibold text-muted">Name</th>
                                        <th class="text-uppercase small fw-semibold text-muted">Category</th>
                                        <th class="text-uppercase small fw-semibold text-muted">Price</th>
                                        <th class="text-uppercase small fw-semibold text-muted">Stock</th>
                                        <th class="text-uppercase small fw-semibold text-muted">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% recentProducts.forEach(function(product) { %>
                                    <tr>
                                        <td>
                                            <img src="/<%= product.image %>" alt="<%= product.name %>" class="rounded" width="50" height="50" style="object-fit:cover;">
                                        </td>
                                        <td class="fw-semibold"><%= product.name %></td>
                                        <td><span class="badge bg-light text-dark border"><%= product.category ? product.category.name : 'N/A' %></span></td>
                                        <td class="fw-semibold">$<%= product.price %></td>
                                        <td>
                                            <% if (product.stock <= 0) { %>
                                                <span class="badge bg-danger-subtle text-danger">Out</span>
                                            <% } else if (product.stock <= 20) { %>
                                                <span class="badge bg-warning-subtle text-warning"><%= product.stock %></span>
                                            <% } else { %>
                                                <span class="badge bg-success-subtle text-success"><%= product.stock %></span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <a href="/admin/products/edit/<%= product._id %>" class="btn btn-sm btn-outline-dark">Edit</a>
                                        </td>
                                    </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function toggleSidebar() {
            document.getElementById('adminSidebar').classList.toggle('open');
        }
        document.querySelector('.admin-main').addEventListener('click', function() {
            document.getElementById('adminSidebar').classList.remove('open');
        });
    </script>
</body>
</html>
