<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Products | adidas Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
    <div class="admin-wrapper">
        <%- include('../layout') %>

        <main class="admin-main">
            <header class="admin-topbar d-flex align-items-center justify-content-between px-4 py-3 bg-white border-bottom sticky-top">
                <button class="btn btn-link d-lg-none p-0 text-dark sidebar-toggle" onclick="toggleSidebar()">
                    <i class="bi bi-list fs-4"></i>
                </button>
                <div class="d-flex align-items-center gap-2 ms-auto">
                    <span class="badge bg-dark rounded-1 ls-1">ADMIN</span>
                    <span class="text-muted small fw-medium"><%= typeof user !== 'undefined' && user ? user.name : 'Admin' %></span>
                </div>
            </header>

            <div class="px-4 mt-3">
                <%- include('../../partials/flash') %>
            </div>

            <div class="admin-content p-4">
                <div class="d-flex align-items-start justify-content-between flex-wrap gap-3 mb-4">
                    <div>
                        <h1 class="h3 fw-bold mb-1">Products</h1>
                        <p class="text-muted small mb-0">Manage your product catalog</p>
                    </div>
                    <a href="/admin/products/new" class="btn btn-dark d-inline-flex align-items-center gap-2">
                        <i class="bi bi-plus-lg"></i> Add Product
                    </a>
                </div>

                <div class="card border-0 shadow-sm">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="text-uppercase small fw-semibold text-muted">Image</th>
                                    <th class="text-uppercase small fw-semibold text-muted">
                                        <a href="/admin/products?sort=name&order=<%= sortField === 'name' && sortOrder === 'asc' ? 'desc' : 'asc' %>" class="text-decoration-none text-muted">
                                            Name <%= sortField === 'name' ? (sortOrder === 'asc' ? '↑' : '↓') : '' %>
                                        </a>
                                    </th>
                                    <th class="text-uppercase small fw-semibold text-muted">Category</th>
                                    <th class="text-uppercase small fw-semibold text-muted">
                                        <a href="/admin/products?sort=price&order=<%= sortField === 'price' && sortOrder === 'asc' ? 'desc' : 'asc' %>" class="text-decoration-none text-muted">
                                            Price <%= sortField === 'price' ? (sortOrder === 'asc' ? '↑' : '↓') : '' %>
                                        </a>
                                    </th>
                                    <th class="text-uppercase small fw-semibold text-muted">
                                        <a href="/admin/products?sort=stock&order=<%= sortField === 'stock' && sortOrder === 'asc' ? 'desc' : 'asc' %>" class="text-decoration-none text-muted">
                                            Stock <%= sortField === 'stock' ? (sortOrder === 'asc' ? '↑' : '↓') : '' %>
                                        </a>
                                    </th>
                                    <th class="text-uppercase small fw-semibold text-muted">Rating</th>
                                    <th class="text-uppercase small fw-semibold text-muted">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (products.length === 0) { %>
                                    <tr>
                                        <td colspan="7" class="text-center py-5">
                                            <p class="text-muted mb-3"><i class="bi bi-inbox fs-1 d-block mb-2"></i>No products found</p>
                                            <a href="/admin/products/new" class="btn btn-dark btn-sm">Add your first product</a>
                                        </td>
                                    </tr>
                                <% } else { %>
                                    <% products.forEach(function(product) { %>
                                    <tr>
                                        <td>
                                            <img src="/<%= product.image %>" alt="<%= product.name %>" class="rounded" width="50" height="50" style="object-fit:cover;">
                                        </td>
                                        <td class="fw-semibold text-dark"><%= product.name %></td>
                                        <td><span class="badge bg-light text-dark border"><%= product.category ? product.category.name : 'N/A' %></span></td>
                                        <td class="fw-semibold">$<%= product.price.toFixed(2) %></td>
                                        <td>
                                            <% if (product.stock <= 0) { %>
                                                <span class="badge bg-danger-subtle text-danger">Out of Stock</span>
                                            <% } else if (product.stock <= 20) { %>
                                                <span class="badge bg-warning-subtle text-warning"><%= product.stock %> left</span>
                                            <% } else { %>
                                                <span class="badge bg-success-subtle text-success"><%= product.stock %></span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <span class="text-warning"><i class="bi bi-star-fill"></i></span>
                                            <span class="small"><%= product.rating %></span>
                                        </td>
                                        <td>
                                            <div class="btn-group btn-group-sm" role="group">
                                                <a href="/admin/products/edit/<%= product._id %>" class="btn btn-outline-dark">
                                                    <i class="bi bi-pencil me-1"></i>Edit
                                                </a>
                                                <form action="/admin/products/delete/<%= product._id %>" method="POST" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete &quot;<%= product.name %>&quot;? This cannot be undone.')">
                                                    <button type="submit" class="btn btn-outline-danger btn-sm">
                                                        <i class="bi bi-trash me-1"></i>Delete
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                    <% }); %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Pagination -->
                <% if (totalPages > 1) { %>
                <nav class="mt-4" aria-label="Products pagination">
                    <ul class="pagination justify-content-center mb-0">
                        <li class="page-item <%= currentPage <= 1 ? 'disabled' : '' %>">
                            <a class="page-link text-dark" href="/admin/products?page=<%= currentPage - 1 %>&sort=<%= sortField %>&order=<%= sortOrder %>">
                                <i class="bi bi-chevron-left"></i> Previous
                            </a>
                        </li>
                        <li class="page-item disabled">
                            <span class="page-link text-muted">Page <%= currentPage %> of <%= totalPages %></span>
                        </li>
                        <li class="page-item <%= currentPage >= totalPages ? 'disabled' : '' %>">
                            <a class="page-link text-dark" href="/admin/products?page=<%= currentPage + 1 %>&sort=<%= sortField %>&order=<%= sortOrder %>">
                                Next <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
                <% } %>
            </div>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function toggleSidebar() {
            document.getElementById('adminSidebar').classList.toggle('open');
        }
        document.querySelector('.admin-main').addEventListener('click', function() {
            document.getElementById('adminSidebar').classList.remove('open');
        });
    </script>
</body>
</html>
