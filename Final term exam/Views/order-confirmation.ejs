<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Confirmed | adidas</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .confirm-page { max-width:800px; margin:40px auto; padding:0 20px 60px; text-align:center; }
        .confirm-icon { font-size:3rem; margin-bottom:16px; }
        .confirm-page h1 { font-family:'AdihausDIN',Arial,sans-serif; font-size:1.6rem; font-weight:700; text-transform:uppercase; letter-spacing:2px; margin-bottom:8px; }
        .confirm-sub { color:#767677; margin-bottom:30px; }
        .order-box { background:#f5f5f5; padding:24px; text-align:left; margin-bottom:24px; }
        .order-box h2 { font-size:0.85rem; font-weight:700; text-transform:uppercase; letter-spacing:1.5px; margin-bottom:16px; padding-bottom:10px; border-bottom:2px solid #000; }
        .order-detail { display:flex; justify-content:space-between; margin-bottom:8px; font-size:0.9rem; }
        .order-detail.total { border-top:2px solid #000; padding-top:10px; margin-top:10px; font-weight:700; font-size:1.05rem; }
        .order-items { margin-top:20px; }
        .oi { display:flex; align-items:center; gap:14px; padding:10px 0; border-bottom:1px solid #e5e5e5; }
        .oi img { width:60px; height:60px; object-fit:cover; background:#fff; }
        .oi-info { flex:1; }
        .oi-name { font-weight:600; font-size:0.85rem; }
        .oi-qty { font-size:0.8rem; color:#767677; }
        .oi-price { font-weight:700; font-size:0.85rem; }
        .confirm-actions { display:flex; gap:12px; justify-content:center; flex-wrap:wrap; margin-top:24px; }
        .confirm-actions a { padding:14px 28px; font-size:0.8rem; font-weight:700; text-transform:uppercase; letter-spacing:2px; text-decoration:none; }
        .btn-dark-custom { background:#000; color:#fff; }
        .btn-dark-custom:hover { background:#333; color:#fff; }
        .btn-outline-custom { background:#fff; color:#000; border:2px solid #000; }
        .btn-outline-custom:hover { background:#000; color:#fff; }
    </style>
</head>
<body>
    <%- include('partials/header') %>
    <div style="max-width:800px; margin:0 auto; padding:0 20px;"><%- include('partials/flash') %></div>

    <div class="confirm-page">
        <div class="confirm-icon">✅</div>
        <h1>Order Confirmed!</h1>
        <p class="confirm-sub">Thank you for your purchase. Your order has been placed successfully.</p>

        <div class="order-box">
            <h2>Order Details</h2>
            <div class="order-detail"><span>Order ID</span><span style="font-family:monospace;"><%= order._id.toString().slice(-8).toUpperCase() %></span></div>
            <div class="order-detail"><span>Status</span><span style="text-transform:capitalize;"><%= order.status %></span></div>
            <div class="order-detail"><span>Date</span><span><%= new Date(order.createdAt).toLocaleDateString('en-US', { month:'long', day:'numeric', year:'numeric' }) %></span></div>
            <% if (order.shippingInfo && order.shippingInfo.address) { %>
            <div class="order-detail"><span>Shipping</span><span><%= order.shippingInfo.address %>, <%= order.shippingInfo.city %> <%= order.shippingInfo.zip %></span></div>
            <% } %>
            <div class="order-detail total"><span>Total</span><span>$<%= order.total.toFixed(2) %></span></div>

            <div class="order-items">
                <% order.items.forEach(function(item) { %>
                <div class="oi">
                    <img src="/<%= item.product ? item.product.image : 'images/placeholder.avif' %>" alt="">
                    <div class="oi-info">
                        <div class="oi-name"><%= item.product ? item.product.name : 'Product' %></div>
                        <div class="oi-qty">Qty: <%= item.quantity %></div>
                    </div>
                    <div class="oi-price">$<%= (item.price * item.quantity).toFixed(2) %></div>
                </div>
                <% }); %>
            </div>
        </div>

        <div class="confirm-actions">
            <a href="/products" class="btn-dark-custom">Continue Shopping</a>
            <a href="/" class="btn-outline-custom">Back to Home</a>
        </div>
    </div>

    <%- include('partials/footer') %>
    <script src="/js/script.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
