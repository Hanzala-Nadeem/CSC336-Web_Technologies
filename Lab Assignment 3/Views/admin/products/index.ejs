<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Products | adidas Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
    <div class="admin-wrapper">
        <%- include('../layout') %>

        <main class="admin-main">
            <header class="admin-topbar">
                <button class="sidebar-toggle" onclick="toggleSidebar()">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M3 6H21M3 12H21M3 18H21" stroke="black" stroke-width="2" stroke-linecap="round"/></svg>
                </button>
                <div class="topbar-right">
                    <span class="admin-badge">ADMIN</span>
                    <span class="admin-name"><%= typeof user !== 'undefined' && user ? user.name : 'Admin' %></span>
                </div>
            </header>

            <div class="admin-flash">
                <%- include('../../partials/flash') %>
            </div>

            <div class="admin-content">
                <div class="page-header">
                    <div>
                        <h1>Products</h1>
                        <p class="text-muted">Manage your product catalog</p>
                    </div>
                    <a href="/admin/products/new" class="action-btn">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M12 5V19M5 12H19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        Add Product
                    </a>
                </div>

                <div class="table-responsive">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Image</th>
                                <th>
                                    <a href="/admin/products?sort=name&order=<%= sortField === 'name' && sortOrder === 'asc' ? 'desc' : 'asc' %>" class="sort-link">
                                        Name <%= sortField === 'name' ? (sortOrder === 'asc' ? '↑' : '↓') : '' %>
                                    </a>
                                </th>
                                <th>Category</th>
                                <th>
                                    <a href="/admin/products?sort=price&order=<%= sortField === 'price' && sortOrder === 'asc' ? 'desc' : 'asc' %>" class="sort-link">
                                        Price <%= sortField === 'price' ? (sortOrder === 'asc' ? '↑' : '↓') : '' %>
                                    </a>
                                </th>
                                <th>
                                    <a href="/admin/products?sort=stock&order=<%= sortField === 'stock' && sortOrder === 'asc' ? 'desc' : 'asc' %>" class="sort-link">
                                        Stock <%= sortField === 'stock' ? (sortOrder === 'asc' ? '↑' : '↓') : '' %>
                                    </a>
                                </th>
                                <th>Rating</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (products.length === 0) { %>
                                <tr>
                                    <td colspan="7" class="text-center py-5">
                                        <p class="text-muted mb-3">No products found</p>
                                        <a href="/admin/products/new" class="action-btn">Add your first product</a>
                                    </td>
                                </tr>
                            <% } else { %>
                                <% products.forEach(function(product) { %>
                                <tr>
                                    <td>
                                        <img src="/<%= product.image %>" alt="<%= product.name %>" class="product-thumb">
                                    </td>
                                    <td class="product-name-cell"><%= product.name %></td>
                                    <td><span class="category-badge"><%= product.category ? product.category.name : 'N/A' %></span></td>
                                    <td class="price-cell">$<%= product.price.toFixed(2) %></td>
                                    <td>
                                        <% if (product.stock <= 0) { %>
                                            <span class="stock-badge stock-out">Out of Stock</span>
                                        <% } else if (product.stock <= 20) { %>
                                            <span class="stock-badge stock-low"><%= product.stock %> left</span>
                                        <% } else { %>
                                            <span class="stock-badge stock-ok"><%= product.stock %></span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <div class="rating-display">
                                            <span class="star filled">★</span>
                                            <span><%= product.rating %></span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="action-group">
                                            <a href="/admin/products/edit/<%= product._id %>" class="btn-action btn-edit">Edit</a>
                                            <form action="/admin/products/delete/<%= product._id %>" method="POST" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete &quot;<%= product.name %>&quot;? This cannot be undone.')">
                                                <button type="submit" class="btn-action btn-delete">Delete</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                                <% }); %>
                            <% } %>
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                <% if (totalPages > 1) { %>
                <nav class="admin-pagination">
                    <a href="/admin/products?page=<%= currentPage - 1 %>&sort=<%= sortField %>&order=<%= sortOrder %>" class="page-btn <%= currentPage <= 1 ? 'disabled' : '' %>">← Previous</a>
                    <span class="page-info">Page <%= currentPage %> of <%= totalPages %></span>
                    <a href="/admin/products?page=<%= currentPage + 1 %>&sort=<%= sortField %>&order=<%= sortOrder %>" class="page-btn <%= currentPage >= totalPages ? 'disabled' : '' %>">Next →</a>
                </nav>
                <% } %>
            </div>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function toggleSidebar() {
            document.getElementById('adminSidebar').classList.toggle('open');
        }
        document.querySelector('.admin-main').addEventListener('click', function() {
            document.getElementById('adminSidebar').classList.remove('open');
        });
    </script>
</body>
</html>
