<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shopping Bag | adidas</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .cart-page { max-width:1100px; margin:40px auto; padding:0 20px 60px; }
        .cart-page h1 { font-family:'AdihausDIN',Arial,sans-serif; font-size:2rem; font-weight:700; text-transform:uppercase; letter-spacing:2px; margin-bottom:8px; }
        .cart-sub { color:#767677; margin-bottom:30px; font-size:0.9rem; }
        .cart-layout { display:grid; grid-template-columns:1fr 360px; gap:30px; }
        .cart-item { display:flex; gap:20px; padding:20px 0; border-bottom:1px solid #e5e5e5; }
        .cart-item:first-child { border-top:1px solid #e5e5e5; }
        .ci-img { width:140px; height:140px; flex-shrink:0; background:#f5f5f5; }
        .ci-img img { width:100%; height:100%; object-fit:cover; }
        .ci-name { font-weight:700; font-size:0.95rem; margin-bottom:4px; }
        .ci-cat { font-size:0.8rem; color:#767677; margin-bottom:12px; }
        .ci-price { font-weight:700; margin-bottom:12px; }
        .ci-total { font-weight:700; font-size:0.9rem; margin-top:4px; }
        .qty-form { display:flex; align-items:center; gap:8px; margin-bottom:8px; }
        .qty-form label { font-size:0.75rem; font-weight:700; text-transform:uppercase; letter-spacing:1px; }
        .qty-form select { padding:6px 10px; border:1px solid #ccc; font-size:0.85rem; }
        .qty-form button { padding:6px 14px; background:#000; color:#fff; border:none; font-size:0.7rem; font-weight:700; text-transform:uppercase; letter-spacing:1px; cursor:pointer; }
        .rm-form button { background:none; border:none; color:#767677; font-size:0.8rem; text-decoration:underline; cursor:pointer; padding:0; }
        .rm-form button:hover { color:#000; }
        .cart-summary { position:sticky; top:120px; }
        .sum-box { background:#f5f5f5; padding:28px; }
        .sum-box h2 { font-size:0.85rem; font-weight:700; text-transform:uppercase; letter-spacing:1.5px; margin-bottom:20px; padding-bottom:12px; border-bottom:2px solid #000; }
        .sum-row { display:flex; justify-content:space-between; margin-bottom:10px; font-size:0.9rem; }
        .sum-total { border-top:2px solid #000; padding-top:12px; margin-top:12px; font-weight:700; font-size:1.1rem; }
        .ck-link { display:block; width:100%; padding:16px; background:#000; color:#fff; border:none; font-size:0.85rem; font-weight:700; text-transform:uppercase; letter-spacing:2px; text-align:center; text-decoration:none; margin-top:20px; transition:background 0.2s; }
        .ck-link:hover { background:#333; color:#fff; }
        .cont-link { display:block; text-align:center; margin-top:12px; font-size:0.8rem; color:#000; text-decoration:underline; }
        .empty-cart { text-align:center; padding:60px 20px; }
        .empty-cart h2 { font-size:1.4rem; font-weight:700; margin-bottom:12px; }
        .empty-cart p { color:#767677; margin-bottom:24px; }
        .empty-cart a { display:inline-block; padding:14px 32px; background:#000; color:#fff; font-size:0.85rem; font-weight:700; text-transform:uppercase; letter-spacing:2px; text-decoration:none; }
        @media (max-width:768px) { .cart-layout { grid-template-columns:1fr; } .ci-img { width:100px; height:100px; } }
    </style>
</head>
<body>
    <%- include('partials/header') %>
    <div style="max-width:1100px; margin:0 auto; padding:0 20px;"><%- include('partials/flash') %></div>

    <div class="cart-page">
        <h1>Your Bag</h1>
        <% if (!cartItems || cartItems.length === 0) { %>
            <div class="empty-cart">
                <h2>Your bag is empty</h2>
                <p>Once you add something to your bag, it will appear here.</p>
                <a href="/products">Shop Now</a>
            </div>
        <% } else { %>
            <p class="cart-sub"><%= cartItems.length %> item<%= cartItems.length > 1 ? 's' : '' %> in your bag</p>
            <div class="cart-layout">
                <div class="cart-items">
                    <% cartItems.forEach(function(item) { %>
                    <div class="cart-item">
                        <div class="ci-img"><img src="/<%= item.product.image %>" alt="<%= item.product.name %>"></div>
                        <div>
                            <div class="ci-name"><%= item.product.name %></div>
                            <div class="ci-cat"><%= item.product.category ? item.product.category.name : 'N/A' %></div>
                            <div class="ci-price">$<%= item.product.price.toFixed(2) %></div>
                            <form class="qty-form" action="/cart/update" method="POST">
                                <input type="hidden" name="productId" value="<%= item.product._id %>">
                                <label>Qty</label>
                                <select name="quantity">
                                    <% for (let i = 1; i <= Math.min(10, item.product.stock); i++) { %>
                                        <option value="<%= i %>" <%= i === item.quantity ? 'selected' : '' %>><%= i %></option>
                                    <% } %>
                                </select>
                                <button type="submit">Update</button>
                            </form>
                            <form class="rm-form" action="/cart/remove" method="POST">
                                <input type="hidden" name="productId" value="<%= item.product._id %>">
                                <button type="submit">Remove</button>
                            </form>
                            <div class="ci-total">Subtotal: $<%= item.itemTotal.toFixed(2) %></div>
                        </div>
                    </div>
                    <% }); %>
                </div>
                <div class="cart-summary">
                    <div class="sum-box">
                        <h2>Order Summary</h2>
                        <div class="sum-row"><span>Subtotal</span><span>$<%= subtotal.toFixed(2) %></span></div>
                        <div class="sum-row"><span>Shipping</span><span>FREE</span></div>
                        <div class="sum-row sum-total"><span>Total</span><span>$<%= total.toFixed(2) %></span></div>
                    </div>
                    <a href="/checkout" class="ck-link">Checkout</a>
                    <a href="/products" class="cont-link">Continue Shopping</a>
                </div>
            </div>
        <% } %>
    </div>

    <%- include('partials/footer') %>
    <script src="/js/script.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
