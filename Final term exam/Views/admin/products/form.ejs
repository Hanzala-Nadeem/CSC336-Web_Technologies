<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= editing ? 'Edit Product' : 'Add New Product' %> | adidas Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
    <div class="admin-wrapper">
        <%- include('../../admin/layout') %>

        <main class="admin-main">
            <header class="admin-topbar d-flex align-items-center justify-content-between px-4 py-3 bg-white border-bottom sticky-top">
                <button class="btn btn-link d-lg-none p-0 text-dark sidebar-toggle" onclick="toggleSidebar()">
                    <i class="bi bi-list fs-4"></i>
                </button>
                <div class="d-flex align-items-center gap-2 ms-auto">
                    <span class="badge bg-dark rounded-1 ls-1">ADMIN</span>
                    <span class="text-muted small fw-medium"><%= typeof user !== 'undefined' && user ? user.name : 'Admin' %></span>
                </div>
            </header>

            <div class="px-4 mt-3">
                <%- include('../../partials/flash') %>
            </div>

            <div class="admin-content p-4">
                <div class="d-flex align-items-start justify-content-between flex-wrap gap-3 mb-4">
                    <div>
                        <h1 class="h3 fw-bold mb-1"><%= editing ? 'Edit Product' : 'Add New Product' %></h1>
                        <p class="text-muted small mb-0"><%= editing ? 'Update product details' : 'Fill in the details to create a new product' %></p>
                    </div>
                    <a href="/admin/products" class="btn btn-outline-dark d-inline-flex align-items-center gap-2">
                        <i class="bi bi-arrow-left"></i> Back to Products
                    </a>
                </div>

                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <form action="<%= editing ? '/admin/products/edit/' + product._id : '/admin/products' %>" method="POST" enctype="multipart/form-data">

                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label for="name" class="form-label fw-semibold text-uppercase small">Product Name *</label>
                                    <input type="text" class="form-control" id="name" name="name" required value="<%= editing ? product.name : '' %>" placeholder="e.g. Samba OG Shoes">
                                </div>
                                <div class="col-md-6">
                                    <label for="category" class="form-label fw-semibold text-uppercase small">Category *</label>
                                    <select class="form-select" id="category" name="category" required>
                                        <option value="">Select Category</option>
                                        <% categories.forEach(function(cat) { %>
                                            <option value="<%= cat._id %>" <%= editing && product.category && product.category.toString() === cat._id.toString() ? 'selected' : '' %>><%= cat.name %></option>
                                        <% }); %>
                                    </select>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="description" class="form-label fw-semibold text-uppercase small">Description</label>
                                <textarea class="form-control" id="description" name="description" rows="3" placeholder="Product description..."><%= editing ? product.description : '' %></textarea>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-md-4">
                                    <label for="price" class="form-label fw-semibold text-uppercase small">Price ($) *</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="bi bi-currency-dollar"></i></span>
                                        <input type="number" class="form-control" id="price" name="price" required min="0" step="0.01" value="<%= editing ? product.price : '' %>" placeholder="0.00">
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <label for="stock" class="form-label fw-semibold text-uppercase small">Stock *</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="bi bi-boxes"></i></span>
                                        <input type="number" class="form-control" id="stock" name="stock" required min="0" value="<%= editing ? product.stock : '0' %>" placeholder="0">
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <label for="rating" class="form-label fw-semibold text-uppercase small">Rating (0-5)</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="bi bi-star"></i></span>
                                        <input type="number" class="form-control" id="rating" name="rating" min="0" max="5" step="0.1" value="<%= editing ? product.rating : '0' %>" placeholder="0.0">
                                    </div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="collection" class="form-label fw-semibold text-uppercase small">Collection</label>
                                <select class="form-select" id="collection" name="collection">
                                    <% ['Originals', 'Sportswear', 'Performance', 'Terrex'].forEach(function(col) { %>
                                        <option value="<%= col %>" <%= editing && product.collection === col ? 'selected' : '' %>><%= col %></option>
                                    <% }); %>
                                </select>
                            </div>

                            <div class="mb-4">
                                <label for="image" class="form-label fw-semibold text-uppercase small">Product Image</label>
                                <div class="border border-2 border-dashed rounded p-4 text-center">
                                    <% if (editing && product.image) { %>
                                        <div class="mb-3" id="imagePreviewContainer">
                                            <img src="/<%= product.image %>" alt="Current image" id="imagePreview" class="rounded shadow-sm" style="max-width:200px;max-height:200px;object-fit:cover;">
                                            <p class="text-muted small mt-2 mb-0">Current image — upload a new one to replace</p>
                                        </div>
                                    <% } else { %>
                                        <div class="mb-3 d-none" id="imagePreviewContainer">
                                            <img src="" alt="Preview" id="imagePreview" class="rounded shadow-sm" style="max-width:200px;max-height:200px;object-fit:cover;">
                                        </div>
                                    <% } %>
                                    <div class="mb-2">
                                        <i class="bi bi-cloud-arrow-up fs-1 text-muted"></i>
                                    </div>
                                    <input type="file" class="form-control mx-auto" style="max-width:400px;" id="image" name="image" accept="image/jpeg,image/jpg,image/png,image/gif,image/webp,image/avif" onchange="previewImage(this)">
                                    <p class="text-muted small mt-2 mb-0"><i class="bi bi-info-circle me-1"></i>JPEG, PNG, GIF, WebP, or AVIF. Max 5MB.</p>
                                </div>
                            </div>

                            <hr>
                            <div class="d-flex gap-2 pt-2">
                                <button type="submit" class="btn btn-dark px-4">
                                    <i class="bi bi-check-lg me-1"></i><%= editing ? 'Update Product' : 'Create Product' %>
                                </button>
                                <a href="/admin/products" class="btn btn-outline-secondary px-4">Cancel</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function toggleSidebar() {
            document.getElementById('adminSidebar').classList.toggle('open');
        }
        document.querySelector('.admin-main').addEventListener('click', function() {
            document.getElementById('adminSidebar').classList.remove('open');
        });

        function previewImage(input) {
            const preview = document.getElementById('imagePreview');
            const container = document.getElementById('imagePreviewContainer');
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    preview.src = e.target.result;
                    container.classList.remove('d-none');
                };
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
</body>
</html>
