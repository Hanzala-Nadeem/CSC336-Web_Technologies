<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= editing ? 'Edit Product' : 'Add New Product' %> | adidas Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
    <div class="admin-wrapper">
        <%- include('../../admin/layout') %>

        <main class="admin-main">
            <header class="admin-topbar">
                <button class="sidebar-toggle" onclick="toggleSidebar()">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M3 6H21M3 12H21M3 18H21" stroke="black" stroke-width="2" stroke-linecap="round"/></svg>
                </button>
                <div class="topbar-right">
                    <span class="admin-badge">ADMIN</span>
                    <span class="admin-name"><%= typeof user !== 'undefined' && user ? user.name : 'Admin' %></span>
                </div>
            </header>

            <div class="admin-flash">
                <%- include('../../partials/flash') %>
            </div>

            <div class="admin-content">
                <div class="page-header">
                    <div>
                        <h1><%= editing ? 'Edit Product' : 'Add New Product' %></h1>
                        <p class="text-muted"><%= editing ? 'Update product details' : 'Fill in the details to create a new product' %></p>
                    </div>
                    <a href="/admin/products" class="action-btn action-btn-outline">← Back to Products</a>
                </div>

                <div class="form-card">
                    <form action="<%= editing ? '/admin/products/edit/' + product._id : '/admin/products' %>" method="POST" enctype="multipart/form-data" class="admin-form">

                        <div class="form-row">
                            <div class="form-col">
                                <div class="form-group">
                                    <label for="name">Product Name *</label>
                                    <input type="text" id="name" name="name" required value="<%= editing ? product.name : '' %>" placeholder="e.g. Samba OG Shoes">
                                </div>
                            </div>
                            <div class="form-col">
                                <div class="form-group">
                                    <label for="category">Category *</label>
                                    <select id="category" name="category" required>
                                        <option value="">Select Category</option>
                                        <% categories.forEach(function(cat) { %>
                                            <option value="<%= cat._id %>" <%= editing && product.category && product.category.toString() === cat._id.toString() ? 'selected' : '' %>><%= cat.name %></option>
                                        <% }); %>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="description">Description</label>
                            <textarea id="description" name="description" rows="3" placeholder="Product description..."><%= editing ? product.description : '' %></textarea>
                        </div>

                        <div class="form-row">
                            <div class="form-col">
                                <div class="form-group">
                                    <label for="price">Price ($) *</label>
                                    <input type="number" id="price" name="price" required min="0" step="0.01" value="<%= editing ? product.price : '' %>" placeholder="0.00">
                                </div>
                            </div>
                            <div class="form-col">
                                <div class="form-group">
                                    <label for="stock">Stock *</label>
                                    <input type="number" id="stock" name="stock" required min="0" value="<%= editing ? product.stock : '0' %>" placeholder="0">
                                </div>
                            </div>
                            <div class="form-col">
                                <div class="form-group">
                                    <label for="rating">Rating (0-5)</label>
                                    <input type="number" id="rating" name="rating" min="0" max="5" step="0.1" value="<%= editing ? product.rating : '0' %>" placeholder="0.0">
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="collection">Collection</label>
                            <select id="collection" name="collection">
                                <% ['Originals', 'Sportswear', 'Performance', 'Terrex'].forEach(function(col) { %>
                                    <option value="<%= col %>" <%= editing && product.collection === col ? 'selected' : '' %>><%= col %></option>
                                <% }); %>
                            </select>
                        </div>

                        <div class="form-group">
                            <label for="image">Product Image</label>
                            <div class="image-upload-area">
                                <% if (editing && product.image) { %>
                                    <div class="current-image">
                                        <img src="/<%= product.image %>" alt="Current image" id="imagePreview">
                                        <p class="text-muted small">Current image — upload a new one to replace</p>
                                    </div>
                                <% } else { %>
                                    <div class="current-image" style="display:none;">
                                        <img src="" alt="Preview" id="imagePreview">
                                    </div>
                                <% } %>
                                <input type="file" id="image" name="image" accept="image/jpeg,image/jpg,image/png,image/gif,image/webp,image/avif" onchange="previewImage(this)">
                                <p class="text-muted small mt-1">JPEG, PNG, GIF, WebP, or AVIF. Max 5MB.</p>
                            </div>
                        </div>

                        <div class="form-actions">
                            <button type="submit" class="action-btn"><%= editing ? 'Update Product' : 'Create Product' %></button>
                            <a href="/admin/products" class="action-btn action-btn-outline">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function toggleSidebar() {
            document.getElementById('adminSidebar').classList.toggle('open');
        }
        document.querySelector('.admin-main').addEventListener('click', function() {
            document.getElementById('adminSidebar').classList.remove('open');
        });

        function previewImage(input) {
            const preview = document.getElementById('imagePreview');
            const container = preview.parentElement;
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    preview.src = e.target.result;
                    container.style.display = 'block';
                };
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
</body>
</html>
