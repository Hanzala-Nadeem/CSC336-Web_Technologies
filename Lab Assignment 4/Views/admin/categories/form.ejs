<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= editing ? 'Edit Category' : 'Add New Category' %> | adidas Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
    <div class="admin-wrapper">
        <%- include('../../admin/layout') %>

        <main class="admin-main">
            <header class="admin-topbar">
                <button class="sidebar-toggle" onclick="toggleSidebar()">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M3 6H21M3 12H21M3 18H21" stroke="black" stroke-width="2" stroke-linecap="round"/></svg>
                </button>
                <div class="topbar-right">
                    <span class="admin-badge">ADMIN</span>
                    <span class="admin-name"><%= typeof user !== 'undefined' && user ? user.name : 'Admin' %></span>
                </div>
            </header>

            <div class="admin-flash">
                <%- include('../../partials/flash') %>
            </div>

            <div class="admin-content">
                <div class="page-header">
                    <div>
                        <h1><%= editing ? 'Edit Category' : 'Add New Category' %></h1>
                        <p class="text-muted"><%= editing ? 'Update category details' : 'Create a new product category' %></p>
                    </div>
                    <a href="/admin/categories" class="action-btn action-btn-outline">← Back to Categories</a>
                </div>

                <div class="form-card">
                    <form action="<%= editing ? '/admin/categories/edit/' + category._id : '/admin/categories' %>" method="POST" class="admin-form">

                        <div class="form-group">
                            <label for="name">Category Name *</label>
                            <input type="text" id="name" name="name" required value="<%= editing ? category.name : '' %>" placeholder="e.g. Shoes">
                            <p class="text-muted small mt-1">The slug will be auto-generated from the name.</p>
                        </div>

                        <div class="form-group">
                            <label for="description">Description</label>
                            <textarea id="description" name="description" rows="3" placeholder="Brief description of this category..."><%= editing ? (category.description || '') : '' %></textarea>
                        </div>

                        <% if (editing && category.slug) { %>
                        <div class="form-group">
                            <label>Current Slug</label>
                            <p class="slug-preview"><code><%= category.slug %></code></p>
                        </div>
                        <% } %>

                        <div class="form-actions">
                            <button type="submit" class="action-btn"><%= editing ? 'Update Category' : 'Create Category' %></button>
                            <a href="/admin/categories" class="action-btn action-btn-outline">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function toggleSidebar() {
            document.getElementById('adminSidebar').classList.toggle('open');
        }
        document.querySelector('.admin-main').addEventListener('click', function() {
            document.getElementById('adminSidebar').classList.remove('open');
        });
    </script>
</body>
</html>
