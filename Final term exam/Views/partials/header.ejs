<!-- HEADER -->
<header id="main-header">
    <div class="promo-bar">
        <div class="promo-content">
            <span>Free returns & exchanges</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                <path d="M7 10L12 15L17 10" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </div>
    </div>

    <div class="utility-links">
        <a href="#">help</a>
        <a href="#">orders and returns</a>
        <a href="#">gift cards</a>
        <% if (typeof user !== 'undefined' && user) { %>
            <% if (user.role === 'admin') { %>
                <a href="/admin" style="font-weight:bold;">admin panel</a>
                <a href="/sales" style="font-weight:bold;">sales dashboard</a>
            <% } %>
            <span style="color: #767677;"><%= user.name %></span>
            <a href="/auth/logout">log out</a>
        <% } else { %>
            <a href="/auth/login">log in</a>
            <a href="/auth/register">register</a>
        <% } %>
    </div>

    <div class="main-nav">
        <button class="MenuToggler" onclick="toggleMenu()">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                <path d="M3 6H21M3 12H21M3 18H21" stroke="black" stroke-width="2" stroke-linecap="round"/>
            </svg>
        </button>

        <div class="logo">
            <a href="/">
                <svg role="presentation" viewBox="100 100 50 32" xmlns="http://www.w3.org/2000/svg">
                    <path fill-rule="evenodd" clip-rule="evenodd"
                          d="M 150.07 131.439 L 131.925 100 L 122.206 105.606 L 137.112 131.439 L 150.07 131.439 Z
                             M 132.781 131.439 L 120.797 110.692 L 111.078 116.298 L 119.823 131.439 L 132.781 131.439 Z
                             M 109.718 121.401 L 115.509 131.439 L 102.551 131.439 L 100 127.007 L 109.718 121.401 Z"
                          fill="black">
                    </path>
                </svg>
            </a>
        </div>

        <nav class="menu">
            <a href="/">HOME</a>
            <a href="#">MEN</a>
            <a href="#">WOMEN</a>
            <a href="#">KIDS</a>
            <a href="/products">SHOES</a>
            <a href="#">SPORTS</a>
            <a href="#">OUTLET</a>
        </nav>

        <div class="header-icons">
            <div class="search-container">
                <input type="text" placeholder="Search" />
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                    <path d="M15.5 14H14.71L14.43 13.73C15.41 12.59 16 11.11 16 9.5C16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-0.59 4.23-1.57L14 14.71V15.5L19 20.49L20.49 19L15.5 14ZM9.5 14C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14Z" fill="black"/>
                </svg>
            </div>
            <svg width="24" height="24" viewBox="0 0 32 32" fill="none">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M9.22548 20H22.7744L26.4218 25.7316L25.5781 26.2684L22.2255 21H9.77443L6.42179 26.2684L5.57812 25.7316L9.22548 20Z" fill="black"></path>
                <path fill-rule="evenodd" clip-rule="evenodd" d="M16 17C18.761 17 21 14.761 21 12C21 9.23895 18.761 7 16 7C13.2377 7 11 9.23881 11 12C11 14.7612 13.2377 17 16 17ZM16 18C19.3133 18 22 15.3133 22 12C22 8.68667 19.3133 6 16 6C12.6853 6 9.99996 8.68667 9.99996 12C9.99996 15.3133 12.6853 18 16 18Z" fill="black"></path>
            </svg>
            <svg width="24" height="24" viewBox="0 0 32 32" fill="none">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M6.7206 6H11.7071L16 10.2929L20.2929 6H25.2794L29.6328 13.0743L16 26.7071L2.36719 13.0743L6.7206 6ZM7.2794 7L3.63281 12.9257L16 25.2929L28.3672 12.9257L24.7206 7H20.7071L16 11.7071L11.2929 7H7.2794Z" fill="black"></path>
            </svg>
            <a href="/cart" style="position:relative; display:inline-flex;">
                <svg width="24" height="24" viewBox="0 0 32 32" fill="none">
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M21 4H11V8H6V28H26V8H21V4ZM20 9V12H21V9H25V27H7V9H11V12H12V9H20ZM20 8V5H12V8H20Z" fill="black"></path>
                </svg>
                <% if (typeof cartCount !== 'undefined' && cartCount > 0) { %>
                    <span style="position:absolute; top:-6px; right:-8px; background:#000; color:#fff; font-size:0.6rem; font-weight:700; width:18px; height:18px; border-radius:50%; display:flex; align-items:center; justify-content:center;"><%= cartCount %></span>
                <% } %>
            </a>
        </div>
    </div>

    <!-- Mobile slide-in menu -->
    <div class="mobile-menu-overlay" id="mobile-menu">
        <div class="mobile-menu-header">
            <div class="mobile-logo">
                <svg role="presentation" viewBox="100 100 50 32" xmlns="http://www.w3.org/2000/svg">
                    <path fill-rule="evenodd" clip-rule="evenodd"
                          d="M 150.07 131.439 L 131.925 100 L 122.206 105.606 L 137.112 131.439 L 150.07 131.439 Z
                             M 132.781 131.439 L 120.797 110.692 L 111.078 116.298 L 119.823 131.439 L 132.781 131.439 Z
                             M 109.718 121.401 L 115.509 131.439 L 102.551 131.439 L 100 127.007 L 109.718 121.401 Z"
                          fill="black">
                    </path>
                </svg>
            </div>
            <button class="close-menu-btn" onclick="toggleMenu()">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                    <path d="M18 6L6 18M6 6L18 18" stroke="black" stroke-width="2" stroke-linecap="round"/>
                </svg>
            </button>
        </div>

        <nav class="mobile-menu-links">
            <a href="/">HOME <span>›</span></a>
            <a href="#">MEN <span>›</span></a>
            <a href="#">WOMEN <span>›</span></a>
            <a href="#">KIDS <span>›</span></a>
            <a href="/products">SHOES <span>›</span></a>
            <a href="#">SPORTS <span>›</span></a>
            <a href="#">OUTLET <span>›</span></a>
        </nav>

        <div class="mobile-menu-extra">
            <a href="#">Order Tracker</a>
            <a href="#">My Profile</a>
            <a href="#">Store finder</a>
            <a href="#">Help & Customer Service</a>
            <a href="#">exchanges & returns</a>
            <a href="#">Become a Member</a>
            <a href="#">Gift Cards</a>
        </div>
    </div>

    <div class="menu-backdrop" id="menu-backdrop" onclick="toggleMenu()"></div>
</header>
